# Docker Compose settings. Do NOT copy this file by hand: generate real secrets with
#
#     python scripts/init_env.py
#
# which writes a git-ignored .env, never overwrites an existing one and never prints a secret.
# All four values are REQUIRED; compose refuses to start without them.

# Signs login tokens (>= 32 chars; the backend refuses weak or placeholder values).
JWT_SECRET=

# Shared secret the backend presents to the research agent (X-Internal-Token).
AGENT_API_KEY=

# Signs CSRF tokens for cookie sessions. Must differ from JWT_SECRET (>= 32 chars).
CSRF_SECRET=

# Database role password. Hex/alphanumeric only (it is embedded in DATABASE_URL).
# IMPORTANT: this is applied only when the data volume is FIRST created. To change the password of an
# existing volume use  python scripts/rotate_db_password.py  (see docs/DB_CREDENTIALS.md) -- editing this
# line alone makes the backend unable to log in.
POSTGRES_PASSWORD=

# ---- Optional ---------------------------------------------------------------------------------------------
# ENVIRONMENT=production   # unsafe settings become startup errors: requires RATE_LIMIT_FAIL_MODE=closed, REDIS_URL,
#                          # ENABLE_HSTS=true, https:// origins, COOKIE_SECURE=true (see docs/AWS_SECRETS_PLAN.md)
# AUTH_MODE=dual           # dual = cookies + legacy Bearer during migration | cookie = cookies only | bearer = legacy only
# COOKIE_SECURE=true       # HTTPS only: Secure flag and __Host-/__Secure- cookie names
# ENABLE_HSTS=true
# POSTGRES_USER=lumen
# POSTGRES_DB=lumen
# CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# Behind a reverse proxy: list ONLY your own proxies. Their X-Forwarded-For is then believed (right-most
# untrusted hop = the client). Empty (default) = trust no header, rate-limit by the connecting address.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
#
# What to do when Redis (shared rate limits) is down: "local" keeps per-process limits (default),
# "closed" refuses login/register/research with 503. Never "unlimited".
# RATE_LIMIT_FAIL_MODE=local
#
# LOCAL DEVELOPMENT ONLY, to keep a legacy weak database password (never in a shared environment):
# ALLOW_INSECURE_DEV_DB=1
