# Copy to .env (git-ignored) next to docker-compose.yml. Both values are REQUIRED.
# Generate each with its own command; never reuse one for the other.

# Signs login tokens. At least 32 chars; the backend refuses to start with a weak/placeholder value.
#   openssl rand -base64 48
JWT_SECRET=

# Shared secret the backend presents to the research agent (X-Internal-Token).
#   openssl rand -base64 32
AGENT_API_KEY=
