{
  "_comment": "EXAMPLE ONLY. Placeholders in <ANGLE_BRACKETS>. Not applied anywhere; no AWS resources were created. Secrets are injected by ECS from AWS Secrets Manager at task start (valueFrom); no secret value appears in this file, in Git, or in an image.",
  "family": "lumen-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/lumen-backend-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/lumen-backend-task",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/lumen-backend:<IMMUTABLE_TAG_OR_DIGEST>",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "readonlyRootFilesystem": true,
      "user": "10001",
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "AUTH_MODE", "value": "dual" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "ENABLE_HSTS", "value": "true" },
        { "name": "RATE_LIMIT_FAIL_MODE", "value": "closed" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "https://<PUBLIC_HOST>" },
        { "name": "TRUSTED_PROXY_CIDRS", "value": "<ALB_SUBNET_CIDR_1>,<ALB_SUBNET_CIDR_2>" },
        { "name": "RESEARCH_AGENT_URL", "value": "http://<AGENT_INTERNAL_DNS>:8004" }
      ],
      "secrets": [
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/app-<SUFFIX>:jwt_secret::" },
        { "name": "CSRF_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/app-<SUFFIX>:csrf_secret::" },
        { "name": "AGENT_API_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/app-<SUFFIX>:agent_api_key::" },
        { "name": "DB_USER", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/db-<SUFFIX>:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/db-<SUFFIX>:password::" },
        { "name": "DB_HOST", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/db-<SUFFIX>:host::" },
        { "name": "DB_PORT", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/db-<SUFFIX>:port::" },
        { "name": "DB_NAME", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/db-<SUFFIX>:dbname::" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:lumen/prod/redis-ratelimit-<SUFFIX>:url::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/lumen/backend",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}
