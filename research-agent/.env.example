# Server
HOST=0.0.0.0
PORT=8004

# Shared secret the BACKEND sends as the X-Internal-Token header (REQUIRED).
# The agent fails closed (503) when this is empty. Generate with: openssl rand -hex 32
# The backend must be given the identical value.
AGENT_API_KEY=

# Request limits (defaults shown)
# MAX_BODY_BYTES=524288
# MAX_QUERY_CHARS=4000
# MAX_HISTORY_ENTRIES=40
# MAX_HISTORY_CONTENT_CHARS=20000
# REQUEST_TIMEOUT_SECONDS=240

# Redis (optional optimisation: the agent runs uncached if Redis is down)
REDIS_URL=redis://localhost:6379
# REDIS_SOCKET_TIMEOUT=1.5

# LLM — OpenRouter primary (REQUIRED)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.3

# LLM — OpenAI fallback (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web Search — Exa primary (REQUIRED)
EXA_API_KEY=exa-...
EXA_MAX_RESULTS=5

# Web Search — Tavily fallback (recommended)
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced

# Jina Reader (optional — free tier works without key)
JINA_API_KEY=

# No keys needed for:
# Wikipedia, OSM Overpass, Nominatim, yfinance,
# Frankfurter, CoinGecko, RSS feeds, PyMuPDF, DuckDuckGo
