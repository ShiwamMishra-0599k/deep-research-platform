# For running the backend outside Docker. Every value below is REQUIRED unless marked optional.

# Strong database password (openssl rand -hex 24). Weak/default passwords such as lumen/postgres/password are
# REFUSED at startup. There is deliberately no default.
DATABASE_URL=

# >= 32 chars, no placeholder words (openssl rand -base64 48)
JWT_SECRET=

# Must equal the research agent's AGENT_API_KEY
AGENT_API_KEY=

RESEARCH_AGENT_URL=http://localhost:8004
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_EXPIRATION_MINUTES=1440
PORT=8080

# Shared rate limiting. Leave empty for in-process limits only (development).
# REDIS_URL=redis://localhost:6379/1
# RATE_LIMIT_FAIL_MODE=local          # or "closed"
# TRUSTED_PROXY_CIDRS=                # ONLY your own reverse proxies, e.g. 10.0.0.0/8

# LOCAL DEVELOPMENT ONLY: permit a weak database password against a local database.
# ALLOW_INSECURE_DEV_DB=1
